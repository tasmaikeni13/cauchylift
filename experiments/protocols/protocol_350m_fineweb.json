  "optimizers": {
    "cauchylift": {
      "lr": 0.001,
      "momentum": 0.95,
      "weight_decay": 0.01,
      "backend": "auto"
    },
    "adamw": {
      "lr": 0.0002,
      "betas": [0.9, 0.95],
      "eps": 1e-8,
      "weight_decay": 0.01
    },
    "muon": {
      "lr": 0.04,
      "momentum": 0.95,
      "weight_decay": 0.01,
      "adamw_lr": 0.0004
    }
  },
  "seeds": [42, 43, 44]
}

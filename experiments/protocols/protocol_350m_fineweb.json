{
  "protocol_version": "1.0",
  "experiment_name": "cauchylift_350m_7b_tokens",
  "target_model": {
    "name": "350M Decoder Transformer",
    "parameters": 348000000,
    "vocab_size": 50257,
    "hidden_dim": 1024,
    "num_layers": 24,
    "num_heads": 16,
    "intermediate_dim": 2816,
    "max_seq_len": 2048,
    "activation": "swiglu",
    "norm_eps": 1e-5,
    "tied_embeddings": true
  },
  "dataset": {
    "name": "FineWeb-Edu",
    "subset": "sample/10BT",
    "train_split": "train",
    "val_split": "validation",
    "total_token_budget": 7000000000
  },
  "training": {
    "hardware": "16x Google Cloud TPU v4 (v4-32 slice)",
    "topology": "2x2x4 3D Torus mesh",
    "seq_len": 2048,
    "micro_batch_size_per_chip": 2,
    "global_micro_batch_size": 32,
    "grad_accum_steps": 4,
    "effective_batch_tokens": 262144,
    "total_optimization_steps": 26703,
    "warmup_steps": 2670,

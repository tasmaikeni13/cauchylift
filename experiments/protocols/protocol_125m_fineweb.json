{
  "protocol_version": "1.0",
  "experiment_name": "cauchylift_125m_3b_tokens",
  "target_model": {
    "name": "125M Decoder Transformer",
    "parameters": 123550000,
    "vocab_size": 50257,
    "hidden_dim": 768,
    "num_layers": 12,
    "num_heads": 12,
    "intermediate_dim": 2048,
    "max_seq_len": 2048,
    "activation": "swiglu",
    "norm_eps": 1e-5,
    "tied_embeddings": true
  },
  "dataset": {
    "name": "FineWeb-Edu",

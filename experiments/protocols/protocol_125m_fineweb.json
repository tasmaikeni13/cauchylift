    "adamw": {
      "lr": 0.0006,
      "betas": [0.9, 0.95],
      "eps": 1e-8,
      "weight_decay": 0.01
    },
    "muon": {
      "lr": 0.02,
      "momentum": 0.95,
      "weight_decay": 0.01
    }
  },
  "seeds": [42, 43, 44]

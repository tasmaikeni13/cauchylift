    "train_split": "train",
    "val_split": "validation",
    "total_token_budget": 3000000000
  },
  "training": {
    "hardware": "8x Google Cloud TPU v6e (Trillium)",
    "topology": "2x4 mesh",
    "seq_len": 2048,
